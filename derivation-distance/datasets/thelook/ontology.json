  "metrics": [
    {
      "name": "revenue",
      "display_name": "Revenue",
      "expression": "SUM(\"SALE_PRICE\")",
      "domain_path": "sales/measuring",
      "description": "Total revenue: sum of order-item sale price for items not cancelled and not returned. USD.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDER_ITEMS",
      "filters": "THELOOK_ECOMMERCE.ORDER_ITEMS.STATUS NOT IN ('Cancelled', 'Returned')",
      "unit": "USD",
      "synonyms": [
        "sales",
        "gmv",
        "total revenue"
      ],
      "notes": null,
      "precomputed_in": null
    },
    {
      "name": "orders",
      "display_name": "Orders",
      "expression": "COUNT(DISTINCT \"ORDER_ID\")",
      "domain_path": "sales/measuring",
      "description": "Number of distinct orders.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDERS",
      "filters": null,
      "unit": null,
      "synonyms": [
        "order count",
        "number of orders"
      ],
      "notes": null,
      "precomputed_in": null
    },
    {
      "name": "completed_orders",
      "display_name": "Completed orders",
      "expression": "COUNT(DISTINCT \"ORDER_ID\")",
      "domain_path": "sales/measuring",
      "description": "Distinct orders with STATUS = 'Complete'.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDERS",
      "filters": "THELOOK_ECOMMERCE.ORDERS.STATUS = 'Complete'",
      "unit": null,
      "synonyms": [
        "complete orders"
      ],
      "notes": null,
      "precomputed_in": null
    },
    {
      "name": "average_order_value",
      "display_name": "Average order value",
      "expression": "SUM(\"SALE_PRICE\") / NULLIF(COUNT(DISTINCT \"ORDER_ID\"), 0)",
      "domain_path": "sales/measuring",
      "description": "Revenue divided by distinct orders. USD.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDER_ITEMS",
      "filters": "THELOOK_ECOMMERCE.ORDER_ITEMS.STATUS NOT IN ('Cancelled', 'Returned')",
      "unit": "USD",
      "synonyms": [
        "AOV",
        "average basket"
      ],
      "notes": null,
      "precomputed_in": null
    },
    {
      "name": "return_rate",
      "display_name": "Return rate",
      "expression": "COUNT(DISTINCT CASE WHEN \"RETURNED_AT\" IS NOT NULL THEN \"ORDER_ID\" END) * 1.0 / NULLIF(COUNT(DISTINCT \"ORDER_ID\"), 0)",
      "domain_path": "sales/measuring",
      "description": "Share of orders that were returned (non-null RETURNED_AT). Ratio between 0 and 1.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDERS",
      "filters": null,
      "unit": "ratio",
      "synonyms": [
        "returns rate",
        "% returned"
      ],
      "notes": null,
      "precomputed_in": null
    },
    {
      "name": "customers",
      "display_name": "Customers",
      "expression": "COUNT(DISTINCT \"USER_ID\")",
      "domain_path": "users",
      "description": "Distinct users who have placed at least one order.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDERS",
      "filters": null,
      "unit": null,
      "synonyms": [
        "buyers",
        "number of customers"
      ],
      "notes": null,
      "precomputed_in": null
    },
    {
      "name": "total_spend",
      "display_name": "Customer total spend",
      "expression": "SUM(\"SALE_PRICE\")",
      "domain_path": "sales/measuring",
      "description": "A customer's lifetime revenue: revenue grouped by USER_ID. USD.",
      "table_schema": "THELOOK_ECOMMERCE",
      "table_name": "ORDER_ITEMS",
      "filters": "THELOOK_ECOMMERCE.ORDER_ITEMS.STATUS NOT IN ('Cancelled', 'Returned')",
      "unit": "USD",
      "synonyms": [
        "lifetime value",
        "LTV",
        "spend per customer"
      ],
      "notes": null,
      "precomputed_in": null
    }
  ],
  "ai_context": "theLook is a synthetic online retailer: registered users place orders, each order contains one or more order items, items map to inventory and products, and products ship from distribution centers. Web events capture browsing.\n\nGlobal rules:\n- **Currency is USD.** All money columns (`SALE_PRICE`, `COST`, `RETAIL_PRICE`) are US dollars.\n- **Revenue** is the sum of `ORDER_ITEMS.SALE_PRICE` for items not cancelled and not returned. Cancelled and returned items do not count.\n- A **completed order** is an order whose `STATUS = 'Complete'`.\n- A **customer** is a user who has placed at least one order. A user who only browsed is not a customer.\n- Identity: users are keyed by `USERS.ID` (= `ORDERS.USER_ID` = `ORDER_ITEMS.USER_ID`).\n- **Return rate** is item-grain: returned items divided by all items, where an item is returned when `ORDER_ITEMS.RETURNED_AT` is not null (equivalently item `STATUS = 'Returned'`). Only use order-level returns when a question explicitly asks about orders.\n- Products are identified by `PRODUCTS.ID`; product names are not unique. Include the product id when reporting per-product results.\n- `USERS.STATE` is populated for users of every country; questions 'by state' cover all countries unless the question restricts to one.\n- Grain trap: revenue lives at the order-item level. Count orders with `COUNT(DISTINCT ORDER_ID)`, never `COUNT(*)` over order items.\n\nDomains: [sales](sales), [catalog](catalog), [fulfillment](fulfillment), [users](users), [web](web)."
}